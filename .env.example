# bwsort configuration. Never commit this file (.gitignore excludes it).

# Session key from `bw unlock --raw`. While it is valid, it unlocks your local
# vault cache, so clear this line and run `bw lock` when you're done.
# A real environment variable BW_SESSION takes precedence over this value.
BW_SESSION=

# Local Ollama only: the script refuses any host other than localhost/127.0.0.1/::1.
BWSORT_OLLAMA_URL=http://127.0.0.1:11434
BWSORT_MODEL=qwen3.8:27b-q4_K_M

# Items per LLM request during classification.
BWSORT_BATCH_SIZE=20

# Optional: full path to bw.exe if it's not on PATH.
# BW_BIN=C:\path\to\bw.exe
